---
import { render } from "astro:content";

import Base from "../../layouts/Base.astro";
import { formatDate, getPosts } from "../../lib/content";

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { title, description, date, updated, tags, draft } = post.data;
const { Content } = await render(post);
---

<Base title={title} description={description} type="article">
  <article>
    <header>
      <h1>{title}</h1>
      <p class="meta">
        <time datetime={date.toISOString()}>{formatDate(date)}</time>
        {updated && (
          <span>
            · updated{" "}
            <time datetime={updated.toISOString()}>{formatDate(updated)}</time>
          </span>
        )}
        {tags.length > 0 && <span> · {tags.join(", ")}</span>}
        {draft && <strong> · draft</strong>}
      </p>
    </header>
    <div class="prose">
      <Content />
    </div>
  </article>
  <hr />
  <p class="muted">
    Thoughts or corrections? I'm on{" "}
    <a href="https://github.com/ragibkl">GitHub</a> and{" "}
    <a href="https://www.linkedin.com/in/ragibkl/">LinkedIn</a>.
  </p>
</Base>

<style>
  header h1 {
    margin-bottom: 0.25rem;
  }
  .meta {
    color: var(--muted);
    font-size: 0.9rem;
    margin-top: 0;
  }
  .prose :global(h2) {
    margin-top: 2.25rem;
  }
  .prose :global(li + li) {
    margin-top: 0.25rem;
  }
</style>
